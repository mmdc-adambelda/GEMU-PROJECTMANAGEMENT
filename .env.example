# Copy to .env.local for development. NEVER commit real values.

# Supabase project (Dashboard > Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# The publishable (anon) key. Safe for the browser ONLY because every table is protected by RLS.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# Public site URL used in auth e-mail redirects (no trailing slash).
# Local: http://localhost:3000   Production: https://your-domain.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Set to "true" after enabling the Google provider in Supabase Auth to show the Google button.
NEXT_PUBLIC_ENABLE_GOOGLE_AUTH=false

# SERVER-ONLY. Not used by the application today; only needed by tests/seed scripts that call the
# Auth Admin API. Never prefix with NEXT_PUBLIC_ and never expose to the browser.
# SUPABASE_SERVICE_ROLE_KEY=
